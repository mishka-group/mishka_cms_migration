<div id="migration-items-page">
  <.link
    navigate={path(@socket, "/admin/dashboard/migration")}
    data-role="items-back"
    class="inline-flex items-center gap-[6px] text-[12px] font-semibold text-[#7c7a75] transition-colors hover:text-[#17161a]"
  >
    <.icon name="hero-arrow-left" class="size-[13px] rtl:rotate-180" /> {gettext("Migration")}
  </.link>

  <div
    data-role="items-head"
    class="mb-[22px] mt-3 flex flex-wrap items-end justify-between gap-x-6 gap-y-3"
  >
    <div>
      <h1 class="m-0 font-['Newsreader'] text-[30px] font-medium leading-[1.05] tracking-[-0.01em] text-[#17161a]">
        {gettext("Items")}
      </h1>
      <div
        data-role="items-source"
        data-run-id={@run.id}
        class="mt-[7px] max-w-[620px] text-[13.5px] font-medium text-[#7c7a75]"
      >
        {gettext(
          "Everything this site has of %{host} (%{source}), and what each run did with it.",
          host: @run.source_host,
          source: @source
        )}
      </div>
    </div>
    <.link
      navigate={
        path(
          @socket,
          MishkaCmsMigration.MigrationRun.items_path(@run) <>
            "?items_template=item_tree&items_filter_source_kind=category"
        )
      }
      data-role="items-map-categories"
      class="inline-flex h-[34px] items-center gap-1.5 rounded-[10px] border border-[#ecebe6] bg-white px-3 text-[12px] font-bold text-[#4f4bcc] transition-colors hover:bg-[#f4f3fd]"
    >
      <.icon name="hero-share" class="size-[14px]" /> {gettext("Map categories")}
    </.link>
  </div>

  <LanguageNotice.warning run={@run} class="mb-[22px]" />

  <.live_component
    module={MishkaCmsMigrationWeb.Live.Admin.Dashboard.Item.Decisions}
    id="migration-item-decisions"
    run={@run}
    current_user={@current_user}
    list_path={path(@socket, MishkaCmsMigration.MigrationRun.items_path(@run))}
  />

  <.modal id="migration-item-map-modal">
    <.live_component
      module={MishkaGervaz.Form.Web.Live}
      id={MishkaGervaz.Resource.Info.Form.component_id(MishkaCmsMigration.MigrationItem)}
      resource={MishkaCmsMigration.MigrationItem}
      current_user={@current_user}
    />
  </.modal>

  <.live_component
    module={MishkaGervaz.Table.Web.Live}
    id="migration-items-table"
    resource={MishkaCmsMigration.MigrationItem}
    current_user={@current_user}
    url_state={@url_state}
  />
</div>
